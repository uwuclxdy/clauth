{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clauth hook-profile-changed-note",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clauth hook-profile-changed-note",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "clauth self-heal",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_clauth_)?clauth__delegate$",
        "hooks": [
          {
            "type": "command",
            "command": "clauth mcp-await-job",
            "asyncRewake": true,
            "timeout": 4260,
            "rewakeMessage": "A backgrounded clauth delegate finished; its result envelope follows.",
            "rewakeSummary": "clauth delegate results"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "clauth hook-profile-changed-note",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
